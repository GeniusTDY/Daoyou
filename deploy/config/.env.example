# ============================================================
# 离线包部署配置模板
# 用法：cp config/.env.example config/.env  然后按需修改
# 生成随机密钥：./gen-secrets.sh  (自动写入 config/.env)
# ============================================================

# ---- 服务端口 ----
APP_PORT=3000
PG_PORT=5433
REDIS_PORT=6380
NATS_PORT=4222

# ---- PostgreSQL（离线包自动 initdb + 建库，无需预装）----
PG_USER=daoyou
PG_PASSWORD=Daoyou
PG_DB=daoyou
# DATABASE_URL 由上面变量自动拼接，改口令只需改 PG_PASSWORD
DATABASE_URL=postgresql://${PG_USER}:${PG_PASSWORD}@127.0.0.1:${PG_PORT}/${PG_DB}
# 提示：start.sh 每次启动会把内置库 daoyou 角色口令统一成 PG_PASSWORD，
# 因此即使沿用预初始化的内置库，口令以本文件为准，无需手动对齐。

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/0

# ---- NATS ----
NATS_USER=app
NATS_PASSWORD=Daoyou
NATS_SERVERS=nats://127.0.0.1:${NATS_PORT}

# ---- 认证 ----
# 实际访问地址，如 http://192.168.1.10:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
# 运行 ./gen-secrets.sh 后自动生成并写入，也可手动指定
BETTER_AUTH_SECRET=replace-with-random-secret-00000000000000000000
CRON_SECRET=replace-with-random-secret-00000000000000000000

# ============================================================
# 离线接通"生成型"功能（炼丹/命名/黑市谈判/人物生成等）：
# 让游戏调用你自己内网的 OpenAI 兼容推理服务（Ollama / vLLM 等）。
# 仅需 LAN，无需公网。配置 3 处即可：
#
#   LLM_PROVIDER    固定为 openai（或 openai/<模型名>）
#   OPENAI_BASE_URL 指向内网推理服务，如 http://10.0.0.100:8000/v1
#   OPENAI_API_KEY  填任意非空值（内网服务通常不校验 key；必须有值才能启用）
#
# 例（Ollama）：
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=ollama
#   LLM_PROVIDER=openai/qwen2.5
#
# 例（vLLM）：
#   OPENAI_BASE_URL=http://10.0.0.100:8000/v1
#   OPENAI_API_KEY=empty
#   LLM_PROVIDER=openai/Qwen/Qwen2.5-7B-Instruct
#
# 不配置 LLM 时，"生成型"玩法将按无 LLM 兜底降级，其余功能不受影响。
# 默认已开启：指向本机 Ollama（http://127.0.0.1:11434）。若本机无 Ollama 或
# 未拉取对应模型，生成型玩法会自动优雅降级，不会影响其余功能。
# 如需关闭，把下面三个值置空即可；如需指向其他内网 vLLM/Ollama，改 OPENAI_BASE_URL。
# 注意：模型名里不能含 ":"（作为权重分隔符被预留），故 Ollama 标签应写成不带 tag 的
#       模型名（如 qwen2.5，会命中你拉取的对应默认 tag）。
# ============================================================
LLM_PROVIDER=openai/qwen2.5
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# 其他供应商（离线内网一般用不到，如需可按此配置）
# ALIBABA_API_KEY=
# ALIBABA_BASE_URL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=

# ---- SMTP 邮件（可选；离线不配则邮件类功能关闭）----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="万界道友官方 <noreply@example.com>"

# ---- 其他可选项 ----
# 管理员：按道号登记（推荐，无需查用户 ID、无需邮箱映射），多个用英文逗号分隔
# ADMIN_DAOHAOS=admin
# 旧式：按内部邮箱匹配（历史遗留，不推荐）
# ADMIN_EMAILS=
# 按系统用户 ID 匹配（需先查库拿到 ID）
# ADMIN_USER_IDS=
# ALTCHA_HMAC_SECRET=replace-with-random-secret